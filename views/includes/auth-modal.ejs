<!-- ============================================ -->
<!-- AUTH MODAL -->
<!-- ============================================ -->

<div class="modal fade auth-modal" id="authModal" tabindex="-1" aria-labelledby="authModalLabel" aria-hidden="true" data-auth-open="login">
	<div class="modal-dialog modal-dialog-centered auth-modal-dialog">
		<div class="modal-content auth-modal-content">
			<div class="auth-modal-shell">
				<div class="modal-header auth-modal-header">
					<div>
						<h1 class="modal-title" id="authModalLabel">Login</h1>
					</div>
					<button type="button" class="btn-close auth-modal-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>

				<div class="modal-body auth-modal-body">
					<div class="auth-panel is-active" data-auth-panel="login">
						<p class="modal-subtitle">Welcome back. Continue your travel journey.</p>
						<form action="/login" method="POST" novalidate class="needs-validation auth-modal-form">
							<div class="mb-3">
								<label for="loginUsername" class="form-label">Username</label>
								<input name="username" type="text" class="form-control" id="loginUsername" required>
								<div class="valid-feedback">Looks good!</div>
								<div class="invalid-feedback">Username should be valid</div>
							</div>
							<div class="mb-3">
								<label for="loginPassword" class="form-label">Password</label>
								<div class="password-field">
									<input name="password" type="password" class="form-control" id="loginPassword" required data-password-input>
									<button class="password-toggle-btn" type="button" data-password-toggle aria-label="Show password" aria-pressed="false">
										<i class="bi bi-eye"></i>
									</button>
								</div>
								<div class="invalid-feedback">Password should be valid</div>
							</div>
							<button type="submit" class="btn auth-btn-primary w-100">Login</button>
						</form>

						<div class="auth-divider"></div>

						<a href="/auth/google" class="btn auth-btn-google w-100">
							<i class="bi bi-google me-2"></i>
							Login with Google
						</a>
					</div>

					<div class="auth-panel" data-auth-panel="signup">
						<p class="modal-subtitle">Create your account and start exploring.</p>
						<form action="/signup" method="POST" novalidate class="needs-validation auth-modal-form" id="signupOtpForm">
							<div class="mb-3">
								<label for="signupUsername" class="form-label">Username</label>
								<input name="username" type="text" class="form-control" id="signupUsername" required>
								<div class="valid-feedback">Looks good!</div>
								<div class="invalid-feedback">Username should be valid</div>
							</div>
							<div class="mb-3">
								<label for="signupEmail" class="form-label">Email</label>
								<input name="email" type="email" class="form-control" id="signupEmail" required>
								<div class="invalid-feedback">Email should be valid</div>
							</div>
							<div class="mb-3">
								<label for="signupPassword" class="form-label">Password</label>
								<div class="password-field">
									<input name="password" type="password" class="form-control" id="signupPassword" required data-password-input>
									<button class="password-toggle-btn" type="button" data-password-toggle aria-label="Show password" aria-pressed="false">
										<i class="bi bi-eye"></i>
									</button>
								</div>
								<div class="invalid-feedback">Password should be valid</div>
							</div>
							<div class="mb-3 d-none" id="signupOtpWrapper">
								<label for="signupOtp" class="form-label">OTP</label>
								<input name="otp" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" class="form-control" id="signupOtp" placeholder="Enter 6-digit OTP">
								<div class="invalid-feedback">OTP should be 6 digits</div>
							</div>
							<div class="d-grid gap-2">
								<button type="button" class="btn auth-btn-google w-100" id="sendSignupOtpBtn">Send OTP</button>
								<button type="submit" class="btn auth-btn-primary w-100" id="signupVerifyBtn" disabled>Verify OTP &amp; Sign Up</button>
							</div>
						</form>

						<div class="auth-divider"></div>

						<a href="/auth/google" class="btn auth-btn-google w-100">
							<i class="bi bi-google me-2"></i>
							Continue with Google
						</a>
					</div>
				</div>

				<div class="auth-modal-switcher" role="tablist" aria-label="Authentication switcher">
					<button type="button" class="auth-switch-btn d-none" data-auth-switch="login">Switch to Login</button>
					<button type="button" class="auth-switch-btn" data-auth-switch="signup">Switch to Sign Up</button>
				</div>
			</div>
		</div>
	</div>
</div>
