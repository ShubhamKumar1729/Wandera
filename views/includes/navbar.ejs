<!-- ============================================ -->
<!-- NAVBAR -->
<!-- ============================================ -->
<nav class="navbar navbar-expand-lg fixed-top" id="mainNav">
  <div class="container">
    <!-- Logo -->
    <a class="navbar-brand" href="/">
      <span class="logo-icon">🌐</span>
      <span class="logo-text">Wandera</span>
    </a>

    <button class="theme-toggle d-lg-none ms-auto me-1" data-theme-toggle aria-label="Toggle dark mode">
      <span class="sun-icon">☀️</span>
      <span class="moon-icon">🌙</span>
    </button>

    <!-- Mobile Toggle Button -->
    <button 
      class="navbar-toggler" 
      type="button" 
      data-bs-toggle="collapse" 
      data-bs-target="#navbarContent"
      aria-controls="navbarContent" 
      aria-expanded="false" 
      aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Navigation Links -->
    <div class="collapse navbar-collapse" id="navbarContent">
      <ul class="navbar-nav ms-auto align-items-center">
        <li class="nav-item">
          <a class="nav-link <% if (currentPage === 'home') { %>active<% } %>" href="/listings">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <% if (currentPage === 'explore') { %>active<% } %>" href="/listings?explore=1">Explore</a>
        </li>
        <li class="nav-item">
          <a
            class="nav-link <% if (currentPage === 'add') { %>active<% } %>"
            href="<%= currUser ? '/listings/new' : '#' %>"
            <% if (!currUser) { %>data-requires-login="add-experience"<% } %>
          >Add Destination
            
          </a>
        </li>
        
        <!-- User Authentication -->
        <% if (typeof currUser !== 'undefined' && currUser) { %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle user-dropdown" href="#" role="button" data-bs-toggle="dropdown">
              <div class="user-avatar">
                <% if (currUser.profileImage && currUser.profileImage.url) { %>
                  <img
                    src="<%= currUser.profileImage.url %>"
                    alt="Profile"
                    style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;"
                  >
                <% } else { %>
                  <%= currUser.username.charAt(0).toUpperCase() %>
                <% } %>
              </div>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" href="/profile">Profile</a></li>
              <li><a class="dropdown-item" href="/profile/experiences">My Destinations</a></li>
              <li><a class="dropdown-item" href="/profile/wishlist">Wishlist</a></li>
            </ul>
          </li>
        <% } else { %>
          <li class="nav-item ms-2">
            <button type="button" class="btn btn-primary-custom auth-nav-btn" data-auth-open="login" data-bs-toggle="modal" data-bs-target="#authModal">Login</button>
          </li>
          <li class="nav-item ms-2">
            <button type="button" class="btn btn-primary-custom auth-nav-btn" data-auth-open="signup" data-bs-toggle="modal" data-bs-target="#authModal">Sign Up</button>
          </li>
        <% } %>

        <!-- Dark Mode Toggle -->
        <li class="nav-item ms-3 d-none d-lg-flex">
          <button class="theme-toggle" id="themeToggle" data-theme-toggle aria-label="Toggle dark mode">
            <span class="sun-icon">☀️</span>
            <span class="moon-icon">🌙</span>
          </button>
        </li>
      </ul>
    </div>
  </div>
</nav>