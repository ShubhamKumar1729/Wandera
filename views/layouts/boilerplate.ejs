<!DOCTYPE html>
<html lang="en">
<head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content="Wandera - Explore Beyond Boundaries. Discover travel destinations tailored to your budget and trip goals.">
        <title><%= typeof pageTitle !== "undefined" ? pageTitle : "Wandera" %></title>

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
        <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">

        <link rel="stylesheet" href="/css/style.css">
        <link rel="stylesheet" href="/css/styless.css">
        <link rel="stylesheet" href="/css/rating.css">
        <link rel="stylesheet" href="/css/index.css">
        <link rel="stylesheet" href="/css/responsive-enhancements.css">
        <% if (typeof pageStyles !== "undefined" && pageStyles) { %>
            <%- pageStyles %>
        <% } %>

        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🌐</text></svg>">
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
        <script>
            const currentTheme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', currentTheme);
            if (currentTheme === 'dark') {
                document.body.classList.add('dark-mode');
            }
        </script>

        <%- include("../includes/navbar.ejs") %>
        <%- include("../includes/auth-modal.ejs") %>

        <div class="container page-content-offset">
            <%- include("../includes/flash.ejs") %>
            <%- body %>
        </div>

        <%- include("../includes/footer.ejs") %>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
        <script src="/js/script.js"></script>

        <script>
            (function () {
                const modalParam = new URLSearchParams(window.location.search).get("modal");

                if (!modalParam) {
                    return;
                }

                const authModalElement = document.getElementById("authModal");

                if (!authModalElement || !window.bootstrap) {
                    return;
                }

                const authModal = bootstrap.Modal.getOrCreateInstance(authModalElement);
                authModalElement.dataset.authOpen = modalParam;
                authModal.show();
                window.history.replaceState({}, document.title, window.location.pathname);
            })();
        </script>

        <script>
            (function () {
                const themeToggles = Array.from(document.querySelectorAll("[data-theme-toggle]"));

                if (!themeToggles.length) {
                    return;
                }

                themeToggles.forEach(function (themeToggle) {
                    themeToggle.addEventListener("click", function () {
                        document.body.classList.toggle("dark-mode");

                        const nextTheme = document.body.classList.contains("dark-mode") ? "dark" : "light";
                        localStorage.setItem("theme", nextTheme);
                        document.documentElement.setAttribute("data-theme", nextTheme);
                    });
                });
            })();
        </script>
</body>
</html>